@baseUrl = http://localhost:8090

# Sprint 2 demo. Restart the app first (H2 is in memory), then send the requests top to bottom,
# later requests reuse tokens and ids from earlier ones.
# UC20 needs an uploads/ folder in the project root, create it before starting the app.

############################################################
# SETUP
############################################################

### S1. Log in as the seeded admin
# @name admin
POST {{baseUrl}}/api/auth/login
Content-Type: application/json

{
  "email": "root@example.com",
  "password": "password"
}

### S2. Admin registers a staff member (UC4 from Sprint 1)
POST {{baseUrl}}/api/auth/register
Content-Type: application/json
Authorization: Bearer {{admin.response.body.$.token}}

{
  "username": "Jon Staff",
  "email": "jon@example.com",
  "password": "secret123"
}

### S3. Log in as the staff member, everything below runs as staff
# @name staff
POST {{baseUrl}}/api/auth/login
Content-Type: application/json

{
  "email": "jon@example.com",
  "password": "secret123"
}

### S4. Create products to work with (UC2 is multipart/form, so no JSON here)
# @name milk
POST {{baseUrl}}/api/products
Authorization: Bearer {{staff.response.body.$.token}}
Content-Type: application/x-www-form-urlencoded

name=Milk&category=Dairy&price=299&stockQuantity=10

### S5.
# @name cheese
POST {{baseUrl}}/api/products
Authorization: Bearer {{staff.response.body.$.token}}
Content-Type: application/x-www-form-urlencoded

name=Cheese&category=Dairy&price=1490&stockQuantity=5

### S6.
# @name bread
POST {{baseUrl}}/api/products
Authorization: Bearer {{staff.response.body.$.token}}
Content-Type: application/x-www-form-urlencoded

name=Bread&category=Bakery&price=650&stockQuantity=20

############################################################
# UC3: Search and filter products (paginated)
############################################################

### 3.1 No filters, defaults page=0 size=20
GET {{baseUrl}}/api/products
Authorization: Bearer {{staff.response.body.$.token}}

### 3.2 Filter by category (exact match, case sensitive)
GET {{baseUrl}}/api/products?category=Dairy
Authorization: Bearer {{staff.response.body.$.token}}

### 3.3 Price range, only Bread (650) is between 500 and 1000
GET {{baseUrl}}/api/products?minPrice=500&maxPrice=1000
Authorization: Bearer {{staff.response.body.$.token}}

### 3.4 Pagination, 2 per page gives totalPages=2
GET {{baseUrl}}/api/products?page=0&size=2
Authorization: Bearer {{staff.response.body.$.token}}

### 3.5 Out of range page, empty content but correct metadata (not an error)
GET {{baseUrl}}/api/products?page=99
Authorization: Bearer {{staff.response.body.$.token}}

### 3.6 size=500 is capped to 100, not rejected (decision #1)
GET {{baseUrl}}/api/products?size=500
Authorization: Bearer {{staff.response.body.$.token}}

### 3.7 minPrice > maxPrice, expect 400 with fieldErrors
GET {{baseUrl}}/api/products?minPrice=1000&maxPrice=10
Authorization: Bearer {{staff.response.body.$.token}}

############################################################
# UC1: Record stock movement
############################################################

### 1.1 Add 15 Milk, newStockLevel 10 -> 25
POST {{baseUrl}}/api/products/{{milk.response.body.$.id}}/stock-movements
Authorization: Bearer {{staff.response.body.$.token}}
Content-Type: application/json

{
  "quantity": 15,
  "type": "ADD"
}

### 1.2 Remove 5 Milk, newStockLevel 25 -> 20. performedBy is the staff id, taken from the token
POST {{baseUrl}}/api/products/{{milk.response.body.$.id}}/stock-movements
Authorization: Bearer {{staff.response.body.$.token}}
Content-Type: application/json

{
  "quantity": 5,
  "type": "REMOVE"
}

### 1.3 Remove more than in stock, expect 400 (decision #2, stock never goes below 0)
POST {{baseUrl}}/api/products/{{milk.response.body.$.id}}/stock-movements
Authorization: Bearer {{staff.response.body.$.token}}
Content-Type: application/json

{
  "quantity": 999,
  "type": "REMOVE"
}

### 1.4 Zero quantity and no type, expect 400 listing both field errors
POST {{baseUrl}}/api/products/{{milk.response.body.$.id}}/stock-movements
Authorization: Bearer {{staff.response.body.$.token}}
Content-Type: application/json

{
  "quantity": 0
}

### 1.5 Unknown type, expect 400 "Request body is missing or malformed"
POST {{baseUrl}}/api/products/{{milk.response.body.$.id}}/stock-movements
Authorization: Bearer {{staff.response.body.$.token}}
Content-Type: application/json

{
  "quantity": 1,
  "type": "SELL"
}

### 1.6 Product doesn't exist, expect 404
POST {{baseUrl}}/api/products/9999/stock-movements
Authorization: Bearer {{staff.response.body.$.token}}
Content-Type: application/json

{
  "quantity": 1,
  "type": "ADD"
}

### 1.7 No token, expect 401
POST {{baseUrl}}/api/products/{{milk.response.body.$.id}}/stock-movements
Content-Type: application/json

{
  "quantity": 1,
  "type": "ADD"
}

############################################################
# UC10: Update or remove product
############################################################

### 10.1 PATCH only the price, every other field stays the same
PATCH {{baseUrl}}/api/products/{{cheese.response.body.$.id}}
Authorization: Bearer {{staff.response.body.$.token}}
Content-Type: application/json

{
  "price": 1290
}

### 10.2 Invalid values, expect 400 with one fieldError per bad field, nothing is saved
PATCH {{baseUrl}}/api/products/{{cheese.response.body.$.id}}
Authorization: Bearer {{staff.response.body.$.token}}
Content-Type: application/json

{
  "name": "  ",
  "price": -5,
  "stockQuantity": -1
}

### 10.3 Product doesn't exist, expect 404
PATCH {{baseUrl}}/api/products/9999
Authorization: Bearer {{staff.response.body.$.token}}
Content-Type: application/json

{
  "price": 100
}

### 10.4 Delete Bread, expect 204 No Content
DELETE {{baseUrl}}/api/products/{{bread.response.body.$.id}}
Authorization: Bearer {{staff.response.body.$.token}}

### 10.5 Bread is gone, expect 404
GET {{baseUrl}}/api/products/{{bread.response.body.$.id}}
Authorization: Bearer {{staff.response.body.$.token}}



############################################################
# UC9: Flag product for reorder (stretch)
############################################################

### 9.1 Flag Cheese, reorderFlagged becomes true
PATCH {{baseUrl}}/api/products/{{cheese.response.body.$.id}}/reorder-flag
Authorization: Bearer {{staff.response.body.$.token}}
Content-Type: application/json

{
  "flagged": true
}

### 9.2 Missing flagged, expect 400 (Boolean is boxed so missing is null, not a silent false)
PATCH {{baseUrl}}/api/products/{{cheese.response.body.$.id}}/reorder-flag
Authorization: Bearer {{staff.response.body.$.token}}
Content-Type: application/json

{}

############################################################
# UC6: Manage own account
############################################################

### 6.1 Change name
PUT {{baseUrl}}/api/users/me
Authorization: Bearer {{staff.response.body.$.token}}
Content-Type: application/json

{
  "name": "Jon Jonsson"
}

### 6.2 Try to self promote and change email, both are ignored, role stays STAFF (decisions #4, #5)
PUT {{baseUrl}}/api/users/me
Authorization: Bearer {{staff.response.body.$.token}}
Content-Type: application/json

{
  "role": "ADMIN",
  "email": "hacker@example.com"
}

### 6.3 New password with wrong currentPassword, expect 400
PUT {{baseUrl}}/api/users/me
Authorization: Bearer {{staff.response.body.$.token}}
Content-Type: application/json

{
  "password": "newsecret123",
  "currentPassword": "wrong"
}

### 6.4 Too short password, expect 400
PUT {{baseUrl}}/api/users/me
Authorization: Bearer {{staff.response.body.$.token}}
Content-Type: application/json

{
  "password": "short",
  "currentPassword": "secret123"
}

### 6.5 Change password properly
PUT {{baseUrl}}/api/users/me
Authorization: Bearer {{staff.response.body.$.token}}
Content-Type: application/json

{
  "password": "newsecret123",
  "currentPassword": "secret123"
}

### 6.6 Old password no longer works, expect 401
POST {{baseUrl}}/api/auth/login
Content-Type: application/json

{
  "email": "jon@example.com",
  "password": "secret123"
}

### 6.7 New password works
POST {{baseUrl}}/api/auth/login
Content-Type: application/json

{
  "email": "jon@example.com",
  "password": "newsecret123"
}

############################################################
# UC20: Upload profile picture (stretch)
############################################################

### 20.1 Upload avatar.png, profilePicURL is set on the returned user
POST {{baseUrl}}/api/users/me/profile-picture
Authorization: Bearer {{staff.response.body.$.token}}
Content-Type: multipart/form-data; boundary=----demo

------demo
Content-Disposition: form-data; name="image"; filename="avatar.png"
Content-Type: image/png

< ./avatar.png
------demo--
